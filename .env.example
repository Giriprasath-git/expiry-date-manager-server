# Server Environment Variables Template for Deployment (Render / Production)

# Server Port (Render sets this automatically, default: 5001)
PORT=5001

# Environment Mode ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expiry_date_manager?retryWrites=true&w=majority

# Secret key for JWT Token signing
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL deployed on Netlify (used for CORS and cookies)
CLIENT_URL=https://your-netlify-app-name.netlify.app
